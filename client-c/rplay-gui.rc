#include <windows.h>

/* The version comes from client-c/Makefile (RPLAYHUB_VERSION, passed as three numbers through
 * windres -D). These defaults are for builds that do not pass it, e.g. scripts/build-gui-msvc.bat;
 * keep them equal to the Makefile's RPLAYHUB_VERSION. */
#ifndef RPLAYHUB_VER_MAJOR
#define RPLAYHUB_VER_MAJOR 0
#endif
#ifndef RPLAYHUB_VER_MINOR
#define RPLAYHUB_VER_MINOR 1
#endif
#ifndef RPLAYHUB_VER_PATCH
#define RPLAYHUB_VER_PATCH 3
#endif
#define RPLAYHUB_STR_(x) #x
#define RPLAYHUB_VSTR_(a, b, c) RPLAYHUB_STR_(a.b.c)
#define RPLAYHUB_VER_STR RPLAYHUB_VSTR_(RPLAYHUB_VER_MAJOR, RPLAYHUB_VER_MINOR, RPLAYHUB_VER_PATCH)

#define IDI_APPICON 1
IDI_APPICON ICON "rplay-gui.ico"

/* Application manifest: asInvoker, per-monitor-v2 DPI, Common Controls v6, UTF-8 code page. */
1 24 "rplay-gui.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RPLAYHUB_VER_MAJOR,RPLAYHUB_VER_MINOR,RPLAYHUB_VER_PATCH,0
PRODUCTVERSION  RPLAYHUB_VER_MAJOR,RPLAYHUB_VER_MINOR,RPLAYHUB_VER_PATCH,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "rPlayAI"
            VALUE "FileDescription",  "rPlayHub iOS Device Mirroring & Control"
            VALUE "FileVersion",      RPLAYHUB_VER_STR
            VALUE "InternalName",     "rplay-gui"
            VALUE "LegalCopyright",   "Copyright (c) 2026 rPlayAI"
            VALUE "OriginalFilename", "rplay-gui.exe"
            VALUE "ProductName",      "rPlayHub"
            VALUE "ProductVersion",   RPLAYHUB_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
